# Streamlit secrets template for the Parquet/DuckDB app (app/streamlit_parquet.py).
#
# HOW TO USE
#   Local:   copy this file to  .streamlit/secrets.toml  (that path is gitignored)
#            and fill in real values. Or just rely on your local AWS profile +
#            PARQUET_BASE env var.
#   Deploy:  in Streamlit Community Cloud -> app -> Settings -> Secrets,
#            paste the four lines below WITH real values.
#
# NEVER commit real keys. This .example file has placeholders only.

AWS_DEFAULT_REGION = "us-east-2"
AWS_ACCESS_KEY_ID = "YOUR_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY = "YOUR_SECRET_ACCESS_KEY"
